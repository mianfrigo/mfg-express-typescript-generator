{
  "name": "@mianfrigo/express-typescript-generator",
  "version": "2.9.0",
  "description": "Scaffold a production-ready Express 5 + TypeScript API: PostgreSQL (Prisma) or MongoDB, JWT auth, zod validation, OpenAPI/Swagger, tests, CI and Docker. One command.",
  "type": "module",
  "main": "bin/cli.js",
  "bin": {
    "mfg-express-typescript-generator": "bin/cli.js",
    "mfg-express-generator": "bin/cli.js"
  },
  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mianfrigo/mfg-express-typescript-generator.git"
  },
  "keywords": [
    "express",
    "express5",
    "typescript",
    "generator",
    "scaffold",
    "starter",
    "boilerplate",
    "template",
    "cli",
    "create",
    "rest-api",
    "api",
    "openapi",
    "swagger",
    "prisma",
    "postgresql",
    "mongodb",
    "mongoose",
    "zod",
    "jwt",
    "auth",
    "docker",
    "rxjs",
    "vitest",
    "express-ts"
  ],
  "preferGlobal": true,
  "author": "Miguel Frias",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mianfrigo/mfg-express-typescript-generator/issues"
  },
  "homepage": "https://github.com/mianfrigo/mfg-express-typescript-generator#readme",
  "scripts": {
    "test": "node --test test/options.test.js test/smoke.test.js test/wizard.test.js"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1"
  }
}
