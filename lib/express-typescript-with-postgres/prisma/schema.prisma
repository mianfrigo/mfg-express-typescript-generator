generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  password  String?
//{{roles}}   role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
//{{refresh}}   refreshTokens RefreshToken[]
}

